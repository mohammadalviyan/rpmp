# Server-only origin used by Next.js rewrites and Server Components.
RPMP_API_ORIGIN=http://127.0.0.1:8080

# Presentation data provider. Defaults to mock when unset.
RPMP_DATA_MODE=mock

# The Go API RPMP_ALLOWED_ORIGIN must equal the browser-facing Next.js origin,
# for example http://localhost:3000 during local development.
